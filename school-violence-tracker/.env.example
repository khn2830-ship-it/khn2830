# Supabase Postgres 접속 문자열 (Supabase Dashboard > Project Settings > Database > Connection Pooling, "Transaction" 모드 URI 권장)
DATABASE_URL=postgres://postgres:password@db.xxxxxxxx.supabase.co:6543/postgres?sslmode=no-verify

# 관리자 로그인 비밀번호 (평문 그대로 환경변수에 저장됨. 학교 밖 다른 곳과 겹치지 않는
# 랜덤한 비밀번호를 사용하고, 유출 우려 시 이 값만 바꾸면 즉시 무효화됩니다)
ADMIN_PASSWORD=change-me-to-a-strong-random-password

# 관리자 로그인 세션 서명용 비밀키 (32바이트 이상 랜덤 문자열)
ADMIN_SESSION_SECRET=change-me-to-a-random-long-string

# 조회자 세션 서명용 비밀키 (관리자 세션과 다른 값을 사용하세요)
SESSION_SECRET=change-me-to-another-random-long-string
